{
  "name": "redlark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:edge && npm run check:brand && npm run validate:content && next build && node scripts/validate-export.mjs && node scripts/check-client-secrets.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "brand:build": "tsx scripts/brand.ts",
    "seed": "tsx scripts/seed.ts && node scripts/preview-derivatives.mjs && tsx scripts/validate-content.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "qa:round": "node scripts/review-public.mjs",
    "check:brand": "node scripts/check-no-legacy-name.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test:rls": "tsx --test tests/rls.test.ts",
    "seed:backend": "tsx scripts/backend-seed.ts",
    "test:copy": "tsx --test tests/copy.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@mdx-js/mdx": "^3.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.2",
    "harfbuzzjs": "^1.6.3",
    "jspdf": "^4.2.1",
    "next": "^16.4.0",
    "opentype.js": "^1.3.4",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "svg2pdf.js": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource/bebas-neue": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "imagetracerjs": "^1.2.6",
    "lighthouse": "^13.0.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.6.0",
    "svg-to-pdfkit": "^0.1.8",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
