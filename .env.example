# Copy to ignored .env.local. Values below are empty placeholders, never secrets.
# Production SITE_URL: https://redlarkworkshop.com (build AND Functions).
SITE_URL=
CONTACT_EMAIL=
NEXT_TELEMETRY_DISABLED=1

# Supabase Auth/Postgres only. Public URL/key: build AND Functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy alias, only if the project uses it instead of the publishable key.
SUPABASE_ANON_KEY=
# Secret: Functions only, never NEXT_PUBLIC_ or next.config env.
SUPABASE_SECRET_KEY=
# Legacy secret alias; use one modern/legacy pair, not conflicting values.
SUPABASE_SERVICE_ROLE_KEY=

# Local migration scripts ONLY; not needed in Netlify Functions or the browser.
DATABASE_URL=
DATABASE_CA_CERT=
# Bootstrap script only; a real verified login and TOTP are required.
ADMIN_BOOTSTRAP_EMAIL=

# Secrets: Functions only. Generate distinct random 32-byte base64 values.
SESSION_ENCRYPTION_KEY=
RATE_LIMIT_SECRET=

# All contribution files live in R2. Credentials: Functions only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public API endpoint; Functions AND build (exact-origin CSP), no bucket path.
R2_ENDPOINT=
R2_REGION=auto
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
# Existing local configuration aliases; canonical names above take precedence.
R2_PENDING_BUCKET=
R2_APPROVED_BUCKET=
# Owned HTTPS approved-file origin; Functions AND build.
R2_PUBLIC_BASE_URL=
# Build AND Functions: set 1 only after hosted backend is ready. Blank keeps file archive.
PUBLIC_CATALOGUE_ENABLED=
# Secret: Functions only; triggers production static publication after review.
NETLIFY_BUILD_HOOK=

# Restricted Resend sending key: Functions only. Verified sender address required.
MAIL_PROVIDER_KEY=
MAIL_FROM=
MAIL_TO_TEAM=

# Optional PUBLIC build settings: same-origin cookieless proxy; blank disables it.
ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
REPO_URL=
