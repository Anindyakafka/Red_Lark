# Build-time values for the static export. Rebuild when changed.
# Optional override. Blank uses Netlify's URL (DEPLOY_PRIME_URL for previews),
# or http://localhost:3000 locally. Set an HTTPS origin for other static hosts.
SITE_URL=
NEXT_TELEMETRY_DISABLED=1
# Defaults to the owner-supplied inbox if absent. Explicit blank disables handoff
# and produces a warning. The website never sends mail during the backend hold.
CONTACT_EMAIL=redlarkworkshop@gmail.com
# Backend configuration preparation; account/database integration is still pending.
# Copy this template to .env.local for development; never commit populated keys.
SUPABASE_URL=
# Current publishable key (sb_publishable_...), not the legacy anon JWT.
SUPABASE_PUBLISHABLE_KEY=
# Current secret key (sb_secret_...), reserved for server-side administration.
# Never prefix this with NEXT_PUBLIC_ or put it in next.config.ts env.
SUPABASE_SECRET_KEY=
# R2 configuration preparation; uploads and publication are not connected yet.
# Credentials stay server-only. Scope Object Read & Write to these two buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Account-level S3 endpoint from Cloudflare, without a bucket path.
R2_ENDPOINT=
# S3 signing region, not the physical storage location.
R2_REGION=auto
R2_PENDING_BUCKET=redlark-pending
R2_APPROVED_BUCKET=redlark-approved
MAIL_PROVIDER_KEY=
MAIL_FROM=
MAIL_TO_TEAM=
ANALYTICS_DOMAIN=
# Repository URL is defined once in src/config/site.ts until repository rename.
REPO_URL=
# Optional: same-origin proxy path to a self-hosted Plausible installation.
# Disabled unless BOTH values are provided. Never use a tracking CDN.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
